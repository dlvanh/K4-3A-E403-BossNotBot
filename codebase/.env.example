DISCORD_TOKEN=

# LLM: openai | nvidia | gemini | anthropic | ollama | fake (fake = không gọi AI, chỉ thử luồng)
LLM_PROVIDER=openai
# Tuỳ chọn — bỏ trống để dùng mặc định của preset trong llm_provider.py
LLM_MODEL=
LLM_BASE_URL=
# Chỉ cho model reasoning (vd gpt-5-nano, gpt-5.6-luna): minimal | low | medium | high
LLM_REASONING_EFFORT=

# Chỉ cần key của provider đang chọn
OPENAI_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
